{
  "manifest_version": 3,
  "name": "抽選応募補助",
  "version": "0.9.8",
  "description": "抽選URLの一括オープン・リロード・現在タブから右方向のフォーム入力・規約同意を補助し、サイト別ルールをGitHubから自動取得します。最終の申込・送信・購入・確定操作は自動実行しません。",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "抽選応募補助"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
