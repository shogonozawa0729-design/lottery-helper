{
  "manifest_version": 3,
  "name": "LATIAS",
  "version": "0.9.8.2",
  "description": "抽選URLの一括オープン・左から順のリロード・フォーム入力・規約同意を補助し、サイト別ルールをGitHubから自動取得します。最終の申込・送信・購入・確定操作は自動実行しません。",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LATIAS"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "field_policy.js",
        "safety_gateway.js",
        "rule_candidates.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "0.9.8 Phase 1 safety candidate"
}
