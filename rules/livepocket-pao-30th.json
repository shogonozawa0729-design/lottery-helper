{
  "schemaVersion": 2,
  "id": "livepocket-pao-30th",
  "name": "LivePocket 共通応募者情報",
  "version": "2026.09.04.6",
  "match": {
    "hosts": ["livepocket.jp"],
    "pathPrefixes": ["/purchase/confirm"]
  },
  "stages": [
    {
      "id": "hareruya2-line-code",
      "paths": [{"prefix": "/purchase/confirm"}],
      "requiredText": ["晴れる屋2"],
      "fillActions": [
        {
          "type": "fillProfileByLabel",
          "labelRegex": ".*",
          "selector": "textarea[name^=\"questionnaire_answers\"],input[type=\"text\"][name^=\"questionnaire_answers\"]",
          "profileKey": "hareruyaNumber",
          "transform": "trim"
        }
      ],
      "agreeActions": [
        {
          "type": "checkByLabel",
          "labelRegex": "上記注意事項に同意しチケットの購入・申込をする|注意事項.*同意|同意",
          "selector": "#order_form_purchase_agreement_content,input[type=\"checkbox\"]",
          "delayMs": 120
        }
      ]
    },
    {
      "id": "bigmagic-ikebukuro-players",
      "paths": [{"prefix": "/purchase/confirm"}],
      "requiredText": ["BIGMAGIC", "池袋店"],
      "fillActions": [
        {
          "type": "fillProfileByLabel",
          "labelRegex": ".*",
          "selector": "#question176975_01",
          "profileKey": "playersId",
          "transform": "trim"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": ".*",
          "selector": "#question176976_01",
          "profileKey": "playersName",
          "transform": "trim"
        }
      ],
      "agreeActions": [
        {
          "type": "checkByLabel",
          "labelRegex": "上記注意事項に同意しチケットの購入・申込をする|注意事項.*同意|同意",
          "selector": "#order_form_purchase_agreement_content",
          "delayMs": 120
        }
      ]
    },
    {
      "id": "purchase-confirm",
      "paths": [{"prefix": "/purchase/confirm"}],
      "fillActions": [
        {
          "type": "fillProfileByLabel",
          "labelRegex": "プレイヤーズクラブ.*ID|プレイヤーズ.*ID|プレイヤーズID.*番号|プレイヤーズ.*番号|Players.?Club.*ID|Players?.?ID|Player.?ID",
          "selector": "input[type=\"text\"],input[type=\"number\"],textarea",
          "profileKey": "playersId",
          "transform": "trim"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "プレイヤーズ.*(なまえ|名前|ネーム|ニックネーム)|プレイヤーズクラブ.*(なまえ|名前|ネーム|ニックネーム)|プレイヤーネーム|ニックネーム|Players?.*(Name|Nickname)|Player.?Name",
          "selector": "input[type=\"text\"],textarea",
          "profileKey": "playersName",
          "transform": "trim"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "氏名|お名前|姓名|^名前$|^名前（.*）$",
          "selector": "input[type=\"text\"],textarea",
          "profileKey": "__fullNameExact"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "フリガナ|ふりがな|氏名.*カナ|名前.*カナ|カナ",
          "selector": "input[type=\"text\"],textarea",
          "profileKey": "__fullKana"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "住所|お住まい|所在地",
          "selector": "input[type=\"text\"],textarea",
          "profileKey": "__fullAddress"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "生年月日|誕生日",
          "selector": "input[type=\"text\"],input[type=\"date\"],textarea",
          "profileKey": "__birthDateCompact"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "電話番号|携帯番号|TEL|Tel|tel",
          "selector": "input[type=\"text\"],input[type=\"tel\"],textarea",
          "profileKey": "phone",
          "transform": "digits"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "メールアドレス|メール|E.?mail|e.?mail",
          "selector": "input[type=\"text\"],input[type=\"email\"],textarea",
          "profileKey": "email"
        }
      ],
      "agreeActions": [
        {
          "type": "checkByLabel",
          "labelRegex": "上記注意事項に同意しチケットの購入・申込をする",
          "selector": "#order_form_purchase_agreement_content",
          "delayMs": 120
        },
        {
          "type": "checkByLabel",
          "labelRegex": "同意する|同意します|了承する|承諾する",
          "selector": "input[type=\"checkbox\"],input[type=\"radio\"]"
        },
        {
          "type": "checkByLabel",
          "labelRegex": "注意事項|利用規約|規約.*同意|同意",
          "selector": "input[type=\"checkbox\"]"
        }
      ]
    }
  ],
  "safety": {
    "neverClickTexts": ["チケットを申込む", "申し込む", "申込む", "購入する", "確定", "送信"]
  }
}
