{
  "schemaVersion": 2,
  "id": "google-forms-torecaplaza55-30th",
  "name": "Google Forms 共通応募フォーム",
  "version": "2026.09.04.8",
  "match": {
    "hosts": ["docs.google.com"],
    "pathPrefixes": ["/forms/d/e/"]
  },
  "stages": [
    {
      "id": "shop193-entry-form",
      "paths": [{"prefix": "/forms/d/e/"}],
      "requiredText": ["会員番号", "秋葉原店", "日本橋店"],
      "fillActions": [
        {
          "type": "checkByLabel",
          "labelRegex": "^1BOX\\(20パック\\).*シュリンク.*外箱無し$",
          "selector": "div[role=\"radio\"]"
        },
        {
          "type": "checkByLabel",
          "labelRegex": "^1個$",
          "selector": "div[role=\"radio\"]"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "^氏名(?:（|\\().*会員登録.*(?:）|\\))?.*",
          "selector": "input[type=\"text\"]",
          "profileKey": "__fullNameExact",
          "transform": "trim"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "^会員番号.*ポイントカード.*",
          "selector": "input[type=\"text\"]",
          "profileKey": "shop193Number",
          "transform": "digits"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "当選通知用.*メールアドレス|メールアドレス",
          "selector": "input[type=\"email\"],input[type=\"text\"],textarea",
          "profileKey": "email",
          "transform": "trim"
        }
      ],
      "agreeActions": []
    },
    {
      "id": "entry-form",
      "paths": [{"prefix": "/forms/d/e/"}],
      "requiredText": ["トレカプラザ55通販店", "顧客ID"],
      "fillActions": [
        {
          "type": "checkByLabel",
          "labelRegex": ".*",
          "selector": "div[role=\"checkbox\"][aria-label^=\"返信に表示するメールアドレスとして\"]"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "トレカプラザ55通販店\\s*顧客ID.*",
          "selector": "input[type=\"text\"]",
          "profileKey": "trecaPlaza55Id"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "^お名前.*",
          "selector": "input[type=\"text\"]",
          "profileKey": "__fullNameExact"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "^メールアドレス.*",
          "selector": "textarea,input[type=\"email\"]",
          "profileKey": "email"
        },
        {
          "type": "checkByLabel",
          "labelRegex": "(?:¥|￥|\\d[\\d,]*円|BOX|パック|デッキ|セット)",
          "selector": "div[role=\"checkbox\"],input[type=\"checkbox\"]"
        }
      ],
      "agreeActions": []
    }
  ],
  "safety": {
    "neverClickTexts": ["送信", "フォームをクリア", "購入する", "確定", "申し込む"]
  }
}
