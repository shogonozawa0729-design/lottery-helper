{
  "schemaVersion": 2,
  "id": "google-forms-batoloco-honatsugi",
  "name": "バトロコ本厚木駅前 Google Forms",
  "version": "2026.09.05.25",
  "match": {
    "hosts": ["docs.google.com"],
    "pathPrefixes": ["/forms/d/e/1FAIpQLSdyB_5843GZfNXBkQZSg9407nN6Gin_yr9hhEL4TjK9iJQerw/"]
  },
  "stages": [
    {
      "id": "honatsugi-page1-consent",
      "paths": [{"prefix": "/forms/d/e/1FAIpQLSdyB_5843GZfNXBkQZSg9407nN6Gin_yr9hhEL4TjK9iJQerw/"}],
      "requiredText": ["確認・同意しました"],
      "fillActions": [],
      "agreeActions": [
        {
          "type": "checkByLabel",
          "labelRegex": ".*",
          "selector": "#i7"
        }
      ]
    },
    {
      "id": "honatsugi-final-page",
      "paths": [{"prefix": "/forms/d/e/1FAIpQLSdyB_5843GZfNXBkQZSg9407nN6Gin_yr9hhEL4TjK9iJQerw/"}],
      "requiredText": [
        "ポイントカード発行・登録時のお名前",
        "メールアドレスを入力してください",
        "確認しました。間違いありません"
      ],
      "fillActions": [
        {
          "type": "fillProfileByLabel",
          "labelRegex": "バトロコ.*ポイントカード.*会員番号.*13桁|ポイントカード.*会員番号.*13桁",
          "selector": "textarea,input[type=\"text\"],input[type=\"number\"]",
          "profileKey": "batorocoNumber",
          "transform": "digits"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "ポイントカード発行・登録時のお名前|ポイントカード.*登録時.*名前",
          "selector": "textarea,input[type=\"text\"]",
          "profileKey": "__fullNameExact",
          "transform": "trim"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "電話番号.*ハイフンなし|電話番号",
          "selector": "textarea,input[type=\"text\"],input[type=\"tel\"]",
          "profileKey": "phone",
          "transform": "digits"
        },
        {
          "type": "fillProfileByLabel",
          "labelRegex": "メールアドレスを入力してください|メールアドレス",
          "selector": "textarea,input[type=\"email\"],input[type=\"text\"]",
          "profileKey": "email",
          "transform": "trim"
        }
      ],
      "agreeActions": [
        {
          "type": "checkByLabel",
          "labelRegex": ".*",
          "selector": "#i27"
        }
      ]
    }
  ],
  "safety": {
    "neverClickTexts": ["送信", "フォームをクリア", "購入する", "確定", "申し込む"]
  }
}
