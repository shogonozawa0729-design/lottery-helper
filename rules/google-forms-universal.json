{
  "schemaVersion": 2,
  "id": "google-forms-universal",
  "name": "Google Forms 汎用意味判定",
  "version": "2026.09.05.48",
  "match": {
    "hosts": ["docs.google.com"],
    "pathPrefixes": ["/forms/d/"]
  },
  "stages": [
    {
      "id": "universal-google-form",
      "paths": [{"prefix": "/forms/d/"}],
      "fillActions": [
        {"type":"fillProfileByLabel","labelRegex":"^メールアドレス.*|メールアドレス|連絡先.*メール|当選連絡.*メール|当選通知.*メール|通知用.*メール","selector":"input[type=\"email\"],input[type=\"text\"],textarea","profileKey":"email","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"(?:あなたの)?姓(?:[（(].*?(?:苗字|名字).*?[）)])?|苗字を入力|名字を入力|^姓[：:\\s]","selector":"input[type=\"text\"],textarea","profileKey":"lastName","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"(?:あなたの)?名(?:[（(].*?(?:名前).*?[）)])?|名前を入力|^名[：:\\s]","selector":"input[type=\"text\"],textarea","profileKey":"firstName","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"姓.*(?:フリガナ|ふりがな|カナ)|(?:フリガナ|ふりがな|カナ).*姓|苗字.*(?:フリガナ|ふりがな|カナ)|名字.*(?:フリガナ|ふりがな|カナ)","selector":"input[type=\"text\"],textarea","profileKey":"lastNameKana","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"名.*(?:フリガナ|ふりがな|カナ)|(?:フリガナ|ふりがな|カナ).*名|名前.*(?:フリガナ|ふりがな|カナ)","selector":"input[type=\"text\"],textarea","profileKey":"firstNameKana","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"顔写真付き.*身分証.*お名前|身分証.*記載.*お名前|本人確認書類.*お名前|本人確認.*お名前|お名前.*フルネーム|氏名.*フルネーム|ご本人様確認.*お名前|^氏名.*|本名|姓名","selector":"input[type=\"text\"],textarea","profileKey":"__fullNameExact","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"(?:お名前|氏名|フルネーム).*(?:フリガナ|ふりがな|カタカナ|カナ)|(?:フリガナ|ふりがな|カタカナ|カナ).*(?:フルネーム|お名前|氏名)","selector":"input[type=\"text\"],textarea","profileKey":"__fullKana","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"ご住所|住所|お住まい|所在地","selector":"input[type=\"text\"],textarea","profileKey":"__fullAddress","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"生年月日|誕生日|出生年月日|日付","selector":"input[type=\"date\"]","profileKey":"__birthDate"},
        {"type":"fillProfileByLabel","labelRegex":"電話番号|携帯番号|お電話番号|TEL|Tel|tel","selector":"input[type=\"text\"],input[type=\"tel\"],textarea","profileKey":"phone","transform":"digits"},
        {"type":"fillProfileByLabel","labelRegex":"ポケモンカードゲーム.*(?:トレーナーズウェブサイト|プレイヤーズクラブ).*プレイヤー?ズ?.?ID|トレーナーズウェブサイト.*プレイヤーID|プレイヤーズクラブ.*ID|プレイヤーズ?.?ID|プレイヤー.?ID","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"playersId","transform":"digits"},
        {"type":"fillProfileByLabel","labelRegex":"登録されている.*プレイヤーネーム|プレイヤーズネーム|プレイヤー.?ネーム|ニックネーム","selector":"input[type=\"text\"],textarea","profileKey":"playersName","transform":"trim"},
        {"type":"checkByLabel","labelRegex":"はい.*(?:画面を確認|トレーナーズウェブサイト.*登録|プレイヤーズクラブ.*登録)|(?:トレーナーズウェブサイト|プレイヤーズクラブ).*登録.*はい","selector":"div[role=\"radio\"],input[type=\"radio\"]"},
        {"type":"fillProfileByLabel","labelRegex":"好きなポケモンは何ですか|お気に入り.*ポケモン|好きなポケモン(?:を|は)","selector":"input[type=\"text\"],textarea","profileKey":"favoritePokemon","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"前の質問.*ポケモン.*理由|ポケモン.*好きな理由|好きな理由.*ポケモン","selector":"input[type=\"text\"],textarea","profileKey":"favoritePokemonReason","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"よくイベントに参加している店舗|よく参加している店舗|イベントに参加している店舗.*1か所|参加している店舗・場所|よく参加する店舗・場所","selector":"input[type=\"text\"],textarea","profileKey":"frequentEventPlace","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"好きなデッキ・よく使用しているデッキ|好きなデッキ|よく使用しているデッキ|よく使うデッキ","selector":"input[type=\"text\"],textarea","profileKey":"favoriteDeck","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"前の質問.*デッキ.*理由|デッキの理由|好きなデッキ.*理由","selector":"input[type=\"text\"],textarea","profileKey":"favoriteDeckReason","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"X\\(旧Twitter\\).*アカウント|X\\(旧Twitter\\).*ID|Twitter.*アカウント|Twitter.*ID|X.*@から入力|X.*ID","selector":"input[type=\"text\"],textarea","profileKey":"twitter","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"バトロコ.*ポイントカード.*会員番号|ポイントカード.*会員番号.*13桁|バトロコ.*会員番号","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"batorocoNumber","transform":"digits"},
        {"type":"fillProfileByLabel","labelRegex":"福福トレカ.*ポイントカード.*(?:10桁|番号)|福福トレカ.*(?:会員番号|10桁番号)|ポイントカード.*(?:裏面|記載).*10桁.*福福|福福.*ポイントカード","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"fukufukuNumber","transform":"digits"},
        {"type":"fillProfileByLabel","labelRegex":"MINT.*メンバーズ.*会員番号|MINT.*会員番号|ミント.*会員番号","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"mintNumber","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"CARD BOX.*会員番号|CARDBOX.*会員番号|カードボックス.*会員番号|カードボックス.*会員ID","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"cardboxNumber","transform":"trim"},
        {"type":"fillProfileByLabel","labelRegex":"193.*会員番号|193.*ポイントカード|ポイントカード.*193.*会員番号","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"shop193Number","transform":"digits"},
        {"type":"fillProfileByLabel","labelRegex":"トレカプラザ55.*顧客ID|顧客ID.*トレカプラザ55","selector":"input[type=\"text\"],input[type=\"number\"],textarea","profileKey":"trecaPlaza55Id","transform":"trim"},
        {"type":"checkByLabel","labelRegex":"マイナンバーカード|個人番号カード","selector":"div[role=\"radio\"],input[type=\"radio\"]"}
      ],
      "agreeActions": [
        {
          "type":"checkByLabel",
          "labelRegex":"^(?!.*(?:同意しない|承諾しない|了承しない|希望しない|応募しない|購入しない|不要|キャンセル|受け取らない|受取らない)).*$",
          "selector":"div[role=\"checkbox\"],input[type=\"checkbox\"]"
        }
      ]
    }
  ],
  "safety": {
    "neverClickTexts": ["送信", "フォームをクリア", "購入する", "確定", "申し込む", "応募する"]
  }
}
