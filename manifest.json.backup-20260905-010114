{
    "manifest_version":  3,
    "name":  "抽選応募補助",
    "version":  "0.9.2",
    "description":  "抽選URLの一括オープン・リロード・フォーム入力・規約同意を補助し、サイト別ルールをGitHubから自動取得します。最終の申込・送信・購入・確定操作は自動実行しません。",
    "permissions":  [
                        "storage",
                        "tabs",
                        "activeTab",
                        "scripting",
                        "sidePanel",
                        "clipboardRead"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_title":  "抽選応募補助"
               },
    "side_panel":  {
                       "default_path":  "popup.html"
                   },
    "options_page":  "options.html",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "content.js",
                                           "question_mapper.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ]
}